// ═══════════════════════════════════════
// TrustCart — Prisma Schema
// ═══════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────

enum Plan {
  FREE
  PRO
}

enum Platform {
  AMAZON
  FLIPKART
  MYNTRA
  MEESHO
  SNAPDEAL
  NYKAA
  AJIO
  UNKNOWN
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TrustLabel {
  TRUSTED
  SUSPICIOUS
  FAKE
  UNKNOWN
}

enum Recommendation {
  BUY
  AVOID
  CAUTION
}

// ─── Models ──────────────────────────

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  password_hash String
  name          String?
  plan          Plan         @default(FREE)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  analyses      Analysis[]
  alerts        PriceAlert[]

  @@map("users")
}

model Analysis {
  id                 String           @id @default(uuid()) @db.Uuid
  user_id            String           @db.Uuid
  url                String
  platform           Platform         @default(UNKNOWN)
  status             AnalysisStatus   @default(PENDING)
  job_id             String?
  product_name       String?
  product_image      String?
  authenticity_score Int?
  trust_label        TrustLabel?
  verdict            String?
  recommendation     Recommendation?
  raw_data           Json?
  error_message      String?
  completed_at       DateTime?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  user              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reviews           ReviewAnalysis[]
  price_comparisons PriceComparison[]

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("analyses")
}

model ReviewAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  analysis_id         String   @db.Uuid
  total_reviews       Int
  fake_review_count   Int
  real_review_count   Int
  avg_rating          Float
  rating_distribution Json
  fake_percentage     Float
  suspicious_patterns Json?
  sentiment_summary   String?
  created_at          DateTime @default(now())

  analysis Analysis @relation(fields: [analysis_id], references: [id], onDelete: Cascade)

  @@index([analysis_id])
  @@map("review_analyses")
}

model PriceComparison {
  id          String   @id @default(uuid()) @db.Uuid
  analysis_id String   @db.Uuid
  platform    String
  price       Float
  currency    String   @default("INR")
  url         String
  in_stock    Boolean  @default(true)
  seller_name String?
  fetched_at  DateTime @default(now())

  analysis Analysis @relation(fields: [analysis_id], references: [id], onDelete: Cascade)

  @@index([analysis_id])
  @@map("price_comparisons")
}

model Seller {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  platform     String
  seller_id    String
  rating       Float?
  review_count Int?
  trust_score  Int?
  flags        Json?
  verified     Boolean   @default(false)
  last_checked DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([platform, seller_id])
  @@index([platform, seller_id])
  @@map("sellers")
}

model PriceAlert {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  product_url   String
  platform      String
  target_price  Float
  current_price Float?
  triggered     Boolean   @default(false)
  triggered_at  DateTime?
  created_at    DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([triggered])
  @@map("price_alerts")
}
